// NexTool — Premium All-in-One Online Tools Platform
// Prisma schema (SQLite for the sandbox; PostgreSQL-ready architecture)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication & Users
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  apiKeys       ApiKey[]
  jobs          ProcessingJob[]
  favorites     FavoriteTool[]
  history       ToolHistory[]
  analytics     AnalyticsEvent[]
  subscriptions Subscription[]
  payments      Payment[]
  fileAssets    FileAsset[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tool Registry
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  tools       Tool[]
}

model Tool {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  categoryId    String
  description   String
  icon          String?
  keywords      String    // pipe-separated
  seoTitle      String?
  seoDescription String?
  inputFormats  String?   // pipe-separated
  outputFormats String?   // pipe-separated
  processingType String   // client | server | worker
  maxFileSize   Int       @default(10485760) // 10MB
  premium       Boolean   @default(false)
  featured      Boolean   @default(false)
  popular       Boolean   @default(false)
  active        Boolean   @default(true)
  version       String    @default("1.0.0")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category      Category  @relation(fields: [categoryId], references: [id])
  favorites     FavoriteTool[]
  history       ToolHistory[]
  jobs          ProcessingJob[]
  usage         ToolUsage?

  @@index([categoryId])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Files & Jobs
// ---------------------------------------------------------------------------

model FileAsset {
  id              String   @id @default(cuid())
  userId          String?
  originalName    String
  safeName        String   // sanitized, never trusted for path ops
  mimeType        String   // client-declared (untrusted)
  detectedMimeType String? // from magic bytes (authoritative)
  extension       String
  size            Int
  checksum        String?  // sha256
  storageKey      String   // provider-relative key
  storagePath     String   // absolute/local path (sandbox only)
  role            String   // input | output | quarantine | temporary
  inputJobId      String?
  outputJobId     String?
  inputJob        ProcessingJob? @relation("JobInputs", fields: [inputJobId], references: [id])
  outputJob       ProcessingJob? @relation("JobOutputs", fields: [outputJobId], references: [id])
  scanStatus      String   @default("pending") // pending | clean | infected | suspicious | error | skipped
  expiresAt       DateTime?
  status          String   @default("active") // active | expired | deleted
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([inputJobId])
  @@index([outputJobId])
  @@index([scanStatus])
  @@index([status])

  user            User?    @relation(fields: [userId], references: [id])
}

model ProcessingJob {
  id              String   @id @default(cuid())
  userId          String?
  toolId          String
  status          String   @default("created")
  // created | queued | validating | scanning | processing |
  // validating_output | completed | failed | cancelled | expired
  priority        Int      @default(0)
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  options         String?  // JSON string
  errorCode       String?
  errorMessage    String?
  resultMeta      String?  // JSON: sizes, counts, etc.
  workerId        String?  // which worker picked it up
  idempotencyKey  String?
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id])
  tool            Tool     @relation(fields: [toolId], references: [id])
  events          JobEvent[]
  inputs          FileAsset[] @relation("JobInputs")
  outputs         FileAsset[] @relation("JobOutputs")

  @@index([userId])
  @@index([toolId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([priority])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  level     String   // info | warn | error
  message   String
  meta      String?  // JSON
  createdAt DateTime @default(now())
  job       ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Usage & Analytics
// ---------------------------------------------------------------------------

model ToolUsage {
  toolId     String   @id
  tool       Tool     @relation(fields: [toolId], references: [id])
  totalRuns  Int      @default(0)
  successRuns Int     @default(0)
  failedRuns Int      @default(0)
  lastUsedAt DateTime?

  @@index([toolId])
}

model ToolHistory {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  meta      String?  // JSON
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id])

  @@index([userId])
}

model FavoriteTool {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id])

  @@unique([userId, toolId])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventName String
  meta      String?  // JSON
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([eventName])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// API Platform
// ---------------------------------------------------------------------------

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  name         String
  keyPrefix    String   // visible prefix, e.g. "nt_live_abc…"
  keyHash      String   // hashed secret
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  usage        ApiUsage[]
  @@index([userId])
}

model ApiUsage {
  id        String   @id @default(cuid())
  apiKeyId  String
  endpoint  String
  method    String
  status    Int
  durationMs Int
  createdAt DateTime @default(now())
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  target    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([action])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model FeatureFlag {
  id       String @id @default(cuid())
  key      String @unique
  enabled  Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Tool versioning (Prompt2 §94)
// ---------------------------------------------------------------------------

model ToolVersion {
  id        String   @id @default(cuid())
  toolId    String
  version   String
  notes     String?
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([toolId])
  @@unique([toolId, version])
}

// ---------------------------------------------------------------------------
// Billing: Plans, Subscriptions, Payments (Prompt2 §34, §50-52)
// ---------------------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique        // free | pro | business
  name            String
  description     String?
  priceMonthly    Int      @default(0)    // cents
  priceYearly     Int      @default(0)    // cents
  currency        String   @default("usd")
  maxFileSize     Int      @default(10485760)
  dailyJobs       Int      @default(20)
  monthlyJobs     Int      @default(500)
  batchAllowed    Boolean  @default(false)
  ocrAllowed      Boolean  @default(true)
  apiAllowed      Boolean  @default(false)
  priority        Int      @default(0)    // 0=free, 1=pro, 2=business
  adFree          Boolean  @default(false)
  historyDays     Int      @default(7)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions   Subscription[]
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  status          String   @default("active") // active | canceled | past_due | trialing
  stripeCustomerId String?
  stripeSubId     String?
  currentPeriodEnd DateTime?
  cancelAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan            Plan     @relation(fields: [planId], references: [id])
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id              String   @id @default(cuid())
  subscriptionId  String
  userId          String
  provider        String   // stripe | future
  providerPaymentId String? @unique
  amount          Int      // cents
  currency        String   @default("usd")
  status          String   // pending | succeeded | failed | refunded
  invoiceUrl      String?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Provider connections & workers (Prompt2 §61, §43, §69)
// ---------------------------------------------------------------------------

model ProviderConnection {
  id           String   @id @default(cuid())
  provider     String   @unique // database | redis | storage | pdf | office | image | media | ocr | creative | email | payment | ai | analytics | monitoring | malware | turnstile | cloudflare
  status       String   @default("not_configured") // configured | not_configured | connected | failed
  detail       String?
  lastCheckedAt DateTime?
  checkedBy    String?  // health-check | manual
}

model Worker {
  id            String   @id @default(cuid())
  workerId      String   @unique   // e.g. pdf-01, office-02
  queue         String   // pdf | office | image | media | ocr | creative | cleanup | notification | ai
  status        String   @default("offline") // healthy | idle | busy | degraded | offline
  version       String?
  currentJobId  String?
  lastHeartbeat DateTime?
  startedAt     DateTime?
  meta          String?  // JSON
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([queue])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Rate-limit bucket (in-memory primary, DB fallback for cross-process)
// ---------------------------------------------------------------------------

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique  // ip:1.2.3.4 | user:abc | apikey:xyz | endpoint:/api/v1/...
  count     Int      @default(0)
  windowStart DateTime
  expiresAt DateTime
  @@index([expiresAt])
}
